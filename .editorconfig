root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_size = 4
indent_style = space
trim_trailing_whitespace = true
tab_width = 4

[*.{sh,zsh,fsh}]
indent_size = space
indent_size = 4

[*.{yaml,yml}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2
tab_width = 2

[*.md]
trim_trailing_whitespace = false

[Dockerfile]
indent_size = 4
indents_style = space

[*.{ini,cfg,conf,toml}]
indent_style = space
indent_size = 4

[.env*]
indent_style = space
indent_size = 4

[*.{lock,.min.js}]
trim_trailing_whitespace = false
